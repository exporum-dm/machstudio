    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.0",
    "esbuild": "^0.27.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "pg": "^8.20.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^54.1.0",
    "vitest": "^2.1.0"
  }
